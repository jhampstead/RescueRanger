prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: rescue
Description: Rescue prediction for putatively protein-truncating variants in phased VCF files
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lrescue
